# Local development defaults. No default user or password is created.
ADPE_ENVIRONMENT=development
ADPE_DATABASE_URL=sqlite:///./data/engine.db
ADPE_DATA_DIR=./data
ADPE_PUBLIC_ORIGIN=http://localhost:8000
ADPE_ALLOWED_HOSTS=["localhost","127.0.0.1"]
ADPE_SECURE_COOKIES=false
ADPE_MAX_UPLOAD_BYTES=67108864
ADPE_MAX_USER_STORAGE_BYTES=1073741824
ADPE_MAX_ROWS=2000000
ADPE_MAX_COLUMNS=128
ADPE_SAMPLE_ROWS=5000
ADPE_JOB_TIMEOUT_SECONDS=300
ADPE_WORKER_MEMORY_MB=1024
ADPE_OLLAMA_ENABLED=false
ADPE_OLLAMA_URL=http://127.0.0.1:11434
ADPE_OLLAMA_MODEL=llama3.2:3b
ADPE_WATCHER_USER=
